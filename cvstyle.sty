\ProvidesPackage{cvstyle}

%% ---------------------------- PACKAGES ----------------------------
\RequirePackage[margin=1in]{geometry} 
\RequirePackage{hyperref} 
\RequirePackage{titlesec} 
\RequirePackage{enumitem} 
\RequirePackage{setspace} 


%% --------------------------- FORMATTING ---------------------------
%% Page and paragraph settings
\pagestyle{empty}             % Remove page numbers
\setlength{\parindent}{0pt}   % Remove paragraph indentation
\setstretch{1.1}              % Set line spacing
\setlist[itemize]{            % Custom list spacing
	leftmargin=3.5em, 
	noitemsep, 
	topsep=2pt, 
	parsep=2pt
}   

%% Clickable link options
\hypersetup{                 
	colorlinks=true,
	linkcolor=blue,
	filecolor=magenta,      
	urlcolor=blue,
}

%% Section header formatting
\titleformat{\section}{\large\bfseries\uppercase}{}{0em}{}[\titlerule]
\titlespacing{\section}{0pt}{14pt}{12pt}

%% ------------------------- BIBLIOGRAPHY ---------------------------
\RequirePackage[
	backend=biber, 
	style=numeric, 
	sorting=ymdnt,
	url=false, 
	isbn=false,
	maxbibnames=99,
	eprint=false
]{biblatex}
\addbibresource{publications.bib}

%% Sort publications within the same year by month
\DeclareSortingTemplate{ymdnt}{
	\sort[direction=descending]{\field{sortyear}\field{year}}
	\sort[direction=descending]{\field[padside=left,padwidth=2,padchar=0]{month}\literal{00}}
	\sort{\field{sortname}\field{author}\field{editor}\field{sorttitle}\field{title}}
	\sort{\field{sorttitle}\field{title}}
}

%% Command to bold my name in citations
\renewcommand*{\mkbibnamegiven}[1]{\ifitemannotation{highlight}{\textbf{#1}}{#1}}
\renewcommand*{\mkbibnamefamily}[1]{\ifitemannotation{highlight}{\textbf{#1}}{#1}}

%% ------------------------ CUSTOM COMMANDS -------------------------
%% Custom indent tab
\newcommand{\tab}{\hspace*{15pt}}

